# Profil 802.1X filaire PEAP-MSCHAPv2 - compte employe1 (groupe Collaborateurs -> VLAN 20)
# Copier vers /etc/wpa_supplicant/wired.conf puis remplacer CHANGE_ME.
# Lancement : wpa_supplicant -i ens1 -c /etc/wpa_supplicant/wired.conf -D wired
ctrl_interface=/var/run/wpa_supplicant
eapol_version=2
ap_scan=0
network={
    ssid="N/A"
    key_mgmt=IEEE8021X
    eap=PEAP
    fast_reauth=0
    identity="employe1@lotietelecom.local"
    password="CHANGE_ME"
    phase2="auth=MSCHAPV2"
    phase1="peaplabel=0"
    # Hors labo, valider le certificat du serveur ISE :
    # ca_cert="/etc/ssl/certs/ise-ca.pem"
}
